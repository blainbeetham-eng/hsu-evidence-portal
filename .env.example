# Copy to .env.local for local development. In Vercel, set the same names under
# Project Settings -> Environment Variables. Never commit real values.

# Supabase -> Project Settings -> API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...) or the legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# Airtable personal access token: scopes data.records:read + schema.bases:read,
# access limited to the HSU base (appB1rWuqM3XsYHQz).
AIRTABLE_TOKEN=

# Any long random string. Vercel Cron sends it to /api/sync/airtable.
CRON_SECRET=

# Anthropic Console API key named hsu-evidence-portal (AI summaries of assessment reports).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Google Cloud service account JSON key (whole file contents) for Import from Drive.
# Read-only Drive scope; the "Jobs" folder is shared with the service account as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
